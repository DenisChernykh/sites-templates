                          "type": "text",
                          "id": "ZfdBC",
                          "name": "H3 / Feeling further apart",
                          "metadata": {
                            "type": "heading",
                            "level": 3
                          },
                          "fill": "#262626",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Feeling further apart",
                          "lineHeight": 1.2,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 24,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "dDXSI",
                          "name": "Body",
                          "fill": "#575757",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "You might miss everyday closeness, find it difficult to ask for what you need, or wonder how to talk about a change in your relationship.",
                          "lineHeight": 1.5,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 18,
                          "fontWeight": "normal"
