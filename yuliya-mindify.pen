                          "fontSize": 20,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "ZoFps",
                          "name": "Body",
                          "fill": "#575757",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Think about working hours, travel and the tasks that spill into evenings. Which parts of the week feel chosen, and which feel automatic?",
                          "lineHeight": 1.5,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
