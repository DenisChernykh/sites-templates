                                {
                                  "type": "text",
                                  "id": "UcmtJ",
                                  "x": 0,
                                  "y": 0,
                                  "name": "About / Hi, I’m Julia. I believe everyone deserves a safe space to talk, ",
                                  "metadata": {
                                    "type": "mindify-source-layer",
                                    "sourceKey": "About-23",
                                    "tag": "p"
                                  },
                                  "fill": "#575757",
                                  "textGrowth": "fixed-width-height",
                                  "width": 358,
                                  "height": 105,
                                  "content": "Hi, I’m Julia. I believe everyone deserves a safe space\nto talk, heal, and grow. With over 5 of experience\nas a licensed therapist, I’ve helped countless\nindividuals and couples overcome challenges like\nanxiety, relationship struggles, and life transitions.",
                                  "lineHeight": 1.5,
                                  "textAlign": "center",
                                  "fontFamily": "Apfel Grotezk",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
