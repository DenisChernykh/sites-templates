                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Connection, sound and device power",
                      "lineHeight": 1.5,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "rectangle",
