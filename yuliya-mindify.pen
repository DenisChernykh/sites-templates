                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "text",
              "id": "w2F5s",
              "name": "Inline error",
              "fill": "#575757",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Enter an email address so I can reply.",
              "lineHeight": 1.5,
              "fontFamily": "Apfel Grotezk",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "PNoLX",
          "x": 500,
          "y": 950,
          "name": "Field states",
          "fill": "#262626",
          "textGrowth": "fixed-width",
          "width": 1300,
          "content": "Default → Focus → Filled. Ошибка: после попытки отправки, текст под полем + aria-invalid + связь aria-describedby. Ошибка остаётся до исправления. Не передавать состояние только цветом.\n\nЭто новые проектные состояния: в исходнике формы нет. Белая поверхность, скругление 12 px и синий outline продолжают язык кнопки. Длительность фокуса не анимируется. На телефоне поля — 358 px, tap-зона от 44 px.",
          "lineHeight": 1.5,
          "fontFamily": "Manrope",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "V1jsHT",
          "x": 40,
          "y": 1330,
          "name": "Form / Success specimen",
          "width": 520,
          "fill": "#FFFFFF",
          "cornerRadius": 24,
          "layout": "vertical",
          "gap": 16,
          "padding": 32,
          "children": [
            {
              "type": "text",
              "id": "e9QuP",
              "name": "Success heading",
              "fill": "#262626",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Thanks for reaching out.",
              "lineHeight": 1.1,
              "fontFamily": "Apfel Grotezk",
              "fontSize": 31,
              "fontWeight": "normal",
              "letterSpacing": -0.8
            },
            {
              "type": "text",
              "id": "hWVMM",
              "name": "Success body",
              "fill": "#575757",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Your enquiry has been received. I’ll reply within two working days.",
              "lineHeight": 1.5,
              "fontFamily": "Apfel Grotezk",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "M0tsS",
          "x": 650,
          "y": 1330,
          "name": "Form submission spec",
          "fill": "#262626",
          "textGrowth": "fixed-width",
          "width": 1180,
          "content": "FORM — спецификация будущего исполнения\n\nСостояния: empty → editing → invalid / sending → success или network error. Sending: кнопка “Sending…”, повторная отправка отключена. Success только после подтверждённого ответа сервера; фокус на сообщении. При сетевой ошибке сохранить введённые значения и дать повторить отправку.\n\nТекущее состояние: статичный макет. Форма не подключена, сообщения не отправляются. Email .example и все условия демонстрационные.",
          "lineHeight": 1.5,
          "fontFamily": "Manrope",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "mrOVP",
          "x": 40,
          "y": 1920,
          "name": "Motion preservation",
          "fill": "#262626",
          "textGrowth": "fixed-width",
          "width": 1800,
          "content": "Исходные 16 механизмов / 48 состояний сохранены на доске 03 — MOTION. На главной сохраняются теги по скроллу, последовательное появление слов и бесконечная лента с drag/inertia. Новые страницы используют те же эффекты только на соответствующих компонентах. Полные значения и разделение наблюдений/проектных дополнений — MOTION_SPEC.md.",
          "lineHeight": 1.5,
          "fontFamily": "Manrope",
          "fontSize": 22,
          "fontWeight": "normal"
        }
      ]
    }
