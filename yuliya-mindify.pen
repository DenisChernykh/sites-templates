                          "type": "text",
                          "id": "cIGsy",
                          "name": "H3 / Different hopes for what comes next",
                          "metadata": {
                            "type": "heading",
                            "level": 3
                          },
                          "fill": "#262626",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Different hopes for what comes next",
                          "lineHeight": 1.2,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 24,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
