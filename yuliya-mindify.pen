                          "width": "fill_container",
                          "content": "Feeling further apart",
                          "lineHeight": 1.2,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 20,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "sQFWc",
                          "name": "Body",
                          "fill": "#575757",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "You might miss everyday closeness, find it difficult to ask for what you need, or wonder how to talk about a change in your relationship.",
                          "lineHeight": 1.5,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 16,
