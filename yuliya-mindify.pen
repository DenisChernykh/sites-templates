                {
                  "type": "text",
                  "id": "rkmwC",
                  "name": "Statement body",
                  "fill": "#575757",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You might want to talk about the person you miss, the changes around you, or an ordinary day that now feels different. You can also begin by saying that you do not know what you want to say.",
                  "lineHeight": 1.5,
                  "textAlign": "center",
                  "fontFamily": "Apfel Grotezk",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            }
