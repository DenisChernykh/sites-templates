                          "content": "The same conversation, again",
                          "lineHeight": 1.2,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 20,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "ZoZRe",
                          "name": "Body",
                          "fill": "#575757",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Perhaps a small disagreement becomes a familiar argument. You may want space to describe what happens between you, rather than only the latest disagreement.",
                          "lineHeight": 1.5,
                          "fontFamily": "Apfel Grotezk",
                          "fontSize": 16,
                          "fontWeight": "normal"
