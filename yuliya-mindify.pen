                        "target": "/journal/before-your-first-online-session/#section-5"
                      },
                      "fill": "#4980CC",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Leave room to decide what comes next",
                      "lineHeight": 1.5,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "jMuKO",
                  "name": "section-1",
                  "metadata": {
                    "type": "article-section",
                    "anchor": "section-1"
                  },
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "LRzJc",
                      "name": "H2 / You do not have to prepare a perfect story",
                      "metadata": {
                        "type": "heading",
                        "level": 2
                      },
                      "fill": "#262626",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You do not have to prepare a perfect story",
                      "lineHeight": 1.1,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "G5oXO",
                      "name": "Article paragraph",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You can begin with a question, a situation, or a simple description of what prompted you to get in touch. If it helps, write down a few things you would like to mention. You do not need to send a detailed personal history in an initial contact form.",
                      "lineHeight": 1.6,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "jkUpQ",
                  "name": "section-2",
                  "metadata": {
                    "type": "article-section",
                    "anchor": "section-2"
                  },
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "KTYgF",
                      "name": "H2 / Clarify the practical arrangements",
                      "metadata": {
                        "type": "heading",
                        "level": 2
                      },
                      "fill": "#262626",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Clarify the practical arrangements",
                      "lineHeight": 1.1,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "k5Zok",
                      "name": "Article paragraph",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ask which platform the meeting will use, how you will receive the link and what to do if the connection drops. Confirm the start time and time zone. You can also ask whether anything needs to be completed before the meeting.",
                      "lineHeight": 1.6,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "PfpbI",
                  "name": "section-3",
                  "metadata": {
                    "type": "article-section",
                    "anchor": "section-3"
                  },
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "q8Y8Az",
                      "name": "H2 / Choose a place for the conversation",
                      "metadata": {
                        "type": "heading",
                        "level": 2
                      },
                      "fill": "#262626",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Choose a place for the conversation",
                      "lineHeight": 1.1,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "GMXWU",
                      "name": "Article paragraph",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Think about where you can speak without being overheard or interrupted. Check that your device has power and that you can hear clearly. If finding a private space is difficult, raise that question before the session rather than assuming there is only one way to arrange it.",
                      "lineHeight": 1.6,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ojhgZ",
                  "name": "Keep nearby / Source white card",
                  "width": "fill_container",
                  "fill": "#FFFFFF",
