                  "name": "section-4",
                  "metadata": {
                    "type": "article-section",
                    "anchor": "section-4"
                  },
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "Y6lBMC",
                      "name": "H2 / Keep your questions nearby",
                      "metadata": {
                        "type": "heading",
                        "level": 2
                      },
                      "fill": "#262626",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Keep your questions nearby",
                      "lineHeight": 1.1,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "flONy",
                      "name": "Article paragraph",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You may want to ask about the therapist’s approach and qualifications, the length and cost of sessions, confidentiality and its limits, and arrangements for rescheduling. These are questions to clarify directly; this guide does not set the practice’s policies.",
                      "lineHeight": 1.6,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Ffxg7",
                  "name": "section-5",
                  "metadata": {
                    "type": "article-section",
                    "anchor": "section-5"
                  },
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 20,
                  "children": [
                    {
                      "type": "text",
                      "id": "iIOI7",
                      "name": "H2 / Leave room to decide what comes next",
                      "metadata": {
                        "type": "heading",
                        "level": 2
                      },
                      "fill": "#262626",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Leave room to decide what comes next",
                      "lineHeight": 1.1,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "p02lB",
                      "name": "Article paragraph",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An introductory conversation is also a chance to ask how further work would be discussed. You can ask what continuing would involve, when the arrangements would be reviewed and how to raise questions about the format. There is no need to arrive with every answer.",
                      "lineHeight": 1.6,
                      "fontFamily": "Apfel Grotezk",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
