                                {
                                  "type": "text",
                                  "id": "zJFo4",
                                  "x": 0,
                                  "y": 0,
                                  "name": "About / Hi, I’m Julia. I believe everyone deserves a safe space to talk, ",
                                  "metadata": {
                                    "type": "mindify-source-layer",
                                    "sourceKey": "About-23",
                                    "tag": "p"
                                  },
                                  "fill": "#575757",
                                  "textGrowth": "fixed-width-height",
                                  "width": 500,
                                  "height": 96,
                                  "content": "Hi, I’m Julia. I believe everyone deserves a safe space to talk,\nheal, and grow. With over 5 of experience as a licensed therapist,\nI’ve helped countless individuals and couples overcome\nchallenges like anxiety, relationship struggles, and life transitions.",
                                  "lineHeight": 1.5,
                                  "fontFamily": "Apfel Grotezk",
                                  "fontSize": 16,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
