                      "fontSize": 24,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "Kv4gI",
                      "name": "Body",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
