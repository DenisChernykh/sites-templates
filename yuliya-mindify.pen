                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "D0EX8",
                      "name": "Body",
                      "fill": "#575757",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Each person can describe one situation in their own words. There is no need to agree on a perfect version of the story.",
